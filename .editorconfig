# EditorConfig — RAG in .NET companion code
# Roslyn / C# style rules. Enforced on build via EnforceCodeStyleInBuild=true.

root = true

# ============================================================
# Universal defaults
# ============================================================
[*]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{xml,csproj,props,targets,nuspec,resx}]
indent_size = 2

# ============================================================
# C# files
# ============================================================
[*.{cs,csx}]

# Organize usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# 'this.' / 'Me.' qualification
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Predefined types
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# var preferences — prefer 'var' when the type is apparent
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion

# Modern C# patterns
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_inlined_variable_declaration = true:warning
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion

# 'using' statements
csharp_prefer_simple_using_statement = true:suggestion

# File-scoped namespaces
csharp_style_namespace_declarations = file_scoped:warning

# Braces
csharp_prefer_braces = true:warning

# Null-checking
csharp_style_conditional_delegate_call = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning

# Readonly
dotnet_style_readonly_field = true:warning

# Naming rules ----------------------------------------------------------------
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interface
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = i_prefix

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = *

dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case

dotnet_naming_rule.types_pascal_case.severity = warning
dotnet_naming_rule.types_pascal_case.symbols = types
dotnet_naming_rule.types_pascal_case.style = pascal_case

dotnet_naming_symbols.types.applicable_kinds = class,struct,enum,delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Rule order matters: more specific rules must come first.

# 1. private const / private static readonly fields  ->  PascalCase
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_case

dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static,readonly

# 2. private (non-static) readonly fields  ->  _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_instance_readonly
dotnet_naming_rule.private_fields_underscore.style = underscore_camel

dotnet_naming_symbols.private_instance_readonly.applicable_kinds = field
dotnet_naming_symbols.private_instance_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_instance_readonly.required_modifiers = readonly

dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Severity overrides ----------------------------------------------------------
# CA1812: avoid uninstantiated internal classes — false-positive on placeholder types.
dotnet_diagnostic.CA1812.severity = none
# CA1707: identifier contains underscore — fine for sample folder names like Ch01_HelloWorldRag.
dotnet_diagnostic.CA1707.severity = none
# IDE0290: use primary constructor — leave as suggestion, not warning.
dotnet_diagnostic.IDE0290.severity = suggestion
