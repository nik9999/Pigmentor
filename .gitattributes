# Normalize line endings — text auto-detected, LF in repo.
* text=auto eol=lf

# Force LF on shell scripts and YAML.
*.sh        text eol=lf
*.bash      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Force CRLF on Windows-only files.
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary files.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.docx      binary
*.xlsx      binary
*.pptx      binary
