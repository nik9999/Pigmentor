<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Hosting, builder and dependency injection composition root for the Pigmentor RAG stack.</Description>
    <PackageTags>rag;retrieval-augmented-generation;ai;hosting;composition;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OllamaSharp" Version="5.4.25" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pigmentor.Core\Pigmentor.Core.csproj" />
    <ProjectReference Include="..\Pigmentor.GigaChat\Pigmentor.GigaChat.csproj" />
    <ProjectReference Include="..\Pigmentor.Ingestion\Pigmentor.Ingestion.csproj" />
    <ProjectReference Include="..\Pigmentor.Retrieval\Pigmentor.Retrieval.csproj" />
    <ProjectReference Include="..\Pigmentor.Generation\Pigmentor.Generation.csproj" />
  </ItemGroup>

</Project>

