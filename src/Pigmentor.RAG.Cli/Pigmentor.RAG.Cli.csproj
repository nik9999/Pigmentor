<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Pigmentor.RAG.Cli</AssemblyName>
    <RootNamespace>Pigmentor.RAG.Cli</RootNamespace>
    <Description>Reference command-line interface for the Pigmentor RAG runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pigmentor.App\Pigmentor.App.csproj" />
    <ProjectReference Include="..\Pigmentor.Core\Pigmentor.Core.csproj" />
    <ProjectReference Include="..\Pigmentor.Hosting\Pigmentor.Hosting.csproj" />
    <ProjectReference Include="..\Pigmentor.GigaChat\Pigmentor.GigaChat.csproj" />
    <ProjectReference Include="..\Pigmentor.Ingestion\Pigmentor.Ingestion.csproj" />
    <ProjectReference Include="..\Pigmentor.Retrieval\Pigmentor.Retrieval.csproj" />
    <ProjectReference Include="..\Pigmentor.Generation\Pigmentor.Generation.csproj" />
    <ProjectReference Include="..\Pigmentor.VectorStore.SqliteVec\Pigmentor.VectorStore.SqliteVec.csproj" />
  </ItemGroup>

  <!-- Canonical Models production assets deployment -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\Models\**"
          Exclude="$(MSBuildThisFileDirectory)..\..\Models\*.md;$(MSBuildThisFileDirectory)..\..\Models\**\*.md;$(MSBuildThisFileDirectory)..\..\Models\**\.gitkeep"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\Models')">
      <Link>Models\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\..\dogfood\**"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\dogfood')">
      <Link>dogfood\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <Target Name="CheckBgeM3ModelAssets" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_ModelSourceDir>$(MSBuildThisFileDirectory)..\..\Models\bge-m3</_ModelSourceDir>
      <_ModelFile>$(_ModelSourceDir)\model.onnx</_ModelFile>
      <_TokenizerFile>$(_ModelSourceDir)\tokenizer.json</_TokenizerFile>
    </PropertyGroup>
    <Warning Condition="!Exists('$(_ModelFile)') Or !Exists('$(_TokenizerFile)')"
             Text="BGE-M3 production model assets are missing in Models/bge-m3. Run scripts/download-bge-m3.ps1 (or scripts/download-bge-m3.sh) to download them." />
  </Target>

</Project>

