<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Shared application infrastructure, cross-platform paths, secure credential storage, and runtime composition for Pigmentor apps.</Description>
    <PackageTags>rag;pigmentor;app;security;credentials;configuration</PackageTags>
